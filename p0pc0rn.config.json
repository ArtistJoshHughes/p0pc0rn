{
  "schema": "p0pc0rn.config/0.1",
  "_about": "Describes each model pack of this release: its Hugging Face repository, size, licence and conditions. The app itself reads config.js (the same addresses). No tokens, addresses or personal paths ever go in this file.",
  "app": {
    "name": "p0pc0rn",
    "author": "Joshua Hughes",
    "base_url": "./",
    "_base_url": "Relative on purpose: works at the GitHub Pages path (/p0pc0rn/), at the repo root on 127.0.0.1, and behind tailscale serve.",
    "official_distribution": "https://artistjoshhughes.github.io/p0pc0rn/",
    "_official_distribution": "The GitHub Pages site, built from this repository by .github/workflows/pages.yml; also written in README.md (LICENSE.md section 1).",
    "terms_version": "2026-10-14.2"
  },
  "github": {
    "owner": "ArtistJoshHughes",
    "repo": "p0pc0rn",
    "visibility": "public",
    "pages_url": "https://artistjoshhughes.github.io/p0pc0rn/",
    "repo_url": "https://github.com/ArtistJoshHughes/p0pc0rn",
    "issues_url": "https://github.com/ArtistJoshHughes/p0pc0rn/issues"
  },
  "huggingface": {
    "owner": "JoshHughes",
    "endpoint": "https://huggingface.co",
    "model_url": "{endpoint}/{hf_repo}/resolve/{revision}/",
    "dataset_url": "{endpoint}/datasets/{hf_repo}/resolve/{revision}/",
    "login": {
      "prompt_in_app": true,
      "when": "only for a pack with requires_hf_login: true (none in this release; the in-app sign-in is not built)",
      "token_scope": "read",
      "token_storage": "on the phone only; sent only to the Hugging Face endpoint; never logged, never in Diagnostics"
    }
  },
  "contacts": {
    "x_official": {
      "handle": "@p0pc0rnapp",
      "url": "https://x.com/p0pc0rnapp"
    },
    "x_author": {
      "handle": "@joshhughes___",
      "url": "https://x.com/joshhughes___"
    },
    "issues": "https://github.com/ArtistJoshHughes/p0pc0rn/issues",
    "email": null
  },
  "download_policy": {
    "terms_before_download": "Every pack's terms are shown and accepted on the phone before its first byte downloads.",
    "pin": "revision is the upload commit SHA of each Hugging Face repository, except Klein 9B, which reads \"main\" and is pinned by its manifest_sha256 until its commit pin lands in the next update. The app reads every pack at resolve/<revision>/ and checks its manifest.json against manifest_sha256 (also in config.js) before it uses or keeps it; the manifest lists the sha256 of every chunk",
    "verify": "manifest_sha256 checks manifest.json; the manifest's per-shard and per-chunk sha256 check everything else",
    "modified_notice": "Modified by the p0pc0rn project: converted and quantized from the original weights."
  },
